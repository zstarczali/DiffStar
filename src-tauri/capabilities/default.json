{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DiffStar main window capabilities",
  "windows": [
    "main",
    "splashscreen"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-title",
    "core:window:allow-destroy",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "dialog:allow-message"
  ]
}
